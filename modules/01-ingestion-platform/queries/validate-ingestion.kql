// ---- Lab 1.2: Windows Security events via AMA ----
SecurityEvent
| where TimeGenerated > ago(1d)
| summarize Events = count() by Computer, EventID
| order by Computer asc, Events desc

// ---- Lab 1.3: CEF landed in CommonSecurityLog (and not duplicated in Syslog) ----
CommonSecurityLog
| where TimeGenerated > ago(1h) and DeviceVendor == "VCBHN-Lab"
| project TimeGenerated, DeviceProduct, Activity, SourceIP, DestinationIP, DestinationPort, DeviceAction

Syslog
| where TimeGenerated > ago(1h)
| summarize count() by Facility, SeverityLevel, ProcessName

// ---- Lab 1.4: Azure Activity via policy ----
AzureActivity
| where TimeGenerated > ago(1d)
| where OperationNameValue has_any ("resourceGroups/write", "resourceGroups/delete")
| project TimeGenerated, Caller, OperationNameValue, ActivityStatusValue, ResourceGroup

// ---- Lab 1.5: Threat intelligence ----
ThreatIntelIndicators
| where TimeGenerated > ago(7d)
| project TimeGenerated, ObservableKey, ObservableValue, Confidence, IsActive, ValidUntil

// ---- Lab 1.6: Custom table ----
VCBHNApp_CL
| where TimeGenerated > ago(1d)
| summarize Events = count(), Exported = sumif(RecordCount, Action == "RecordExport") by UserPrincipalName

// ---- Lab 1.7: what is costing money (billable volume by table, last 7 days) ----
Usage
| where TimeGenerated > ago(7d) and IsBillable == true
| summarize GB = round(sum(Quantity) / 1024, 3) by DataType
| order by GB desc
